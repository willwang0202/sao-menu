{
  "name": "sao-menu",
  "version": "0.1.8",
  "private": true,
  "description": "A local cross-platform port of the SAO Utils 2 launcher using its original theme resources",
  "homepage": "https://sao-menu.favioon.com",
  "author": {
    "name": "Will Wang",
    "email": "willwang0202@users.noreply.github.com"
  },
  "type": "module",
  "main": "dist-desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/check-original-assets.mjs && node scripts/prepare-hand-model.mjs && node scripts/dev.mjs",
    "dev:web": "node scripts/check-original-assets.mjs && node scripts/prepare-hand-model.mjs && vite --host 127.0.0.1",
    "build": "node scripts/check-original-assets.mjs && node scripts/prepare-hand-model.mjs && tsc --noEmit && vite build && node scripts/build-desktop.mjs",
    "start": "electron .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:desktop": "npm run build && node scripts/smoke-desktop.mjs",
    "import:assets": "node scripts/import-original-assets.mjs",
    "package": "npm run build && electron-builder --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "test:surfaces": "npm run build && node --import tsx scripts/smoke-surfaces.mjs",
    "test:media": "npm run build && node --import tsx scripts/smoke-media-library.mjs",
    "build:service": "node scripts/build-service.mjs",
    "start:service": "npm run build:service && node dist-service/server.cjs",
    "test:hover": "npm run build && node scripts/smoke-hover.mjs",
    "test:social": "npm run build && node --import tsx scripts/smoke-social.mjs",
    "test:hand": "npm run build && node scripts/smoke-hand.mjs",
    "test:startup": "npm run build && node --import tsx scripts/smoke-startup.mjs",
    "test:startup:frames": "node scripts/compare-startup.mjs 2.5 3.6 4.4 5.8 6.0 7.4 8.4 9.9 10.62 12.8 14.8 16.4 17.3 18.6",
    "test:updates": "node scripts/smoke-updates.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "electron-updater": "6.8.9",
    "fast-xml-parser": "^5.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "vite": "^8.3.2"
  },
  "build": {
    "icon": "resources/icon.png",
    "appId": "dev.sao-utils.port",
    "productName": "SAO Utils 2",
    "artifactName": "sao-menu-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-desktop/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "mac": {
      "artifactName": "sao-menu-${version}-mac-${arch}.${ext}",
      "icon": "resources/icon.icns",
      "extraResources": [
        {
          "from": "dist-desktop/gesture-helper",
          "to": "gesture-helper"
        }
      ],
      "category": "public.app-category.utilities",
      "target": [
        "dir",
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "SAO Utils 2 uses the camera only when you turn on hand gestures, to recognise your hand on this Mac. Video is never recorded or sent anywhere."
      }
    },
    "win": {
      "artifactName": "sao-menu-${version}-windows-${arch}.${ext}",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "artifactName": "sao-menu-${version}-linux-${arch}.${ext}",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "willwang0202",
        "repo": "sao-menu",
        "private": false,
        "releaseType": "draft"
      }
    ]
  }
}
